{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepairSample",
  "type": "object",
  "required": ["sample_id", "vulnerable", "fixed", "bug_types", "expert_labels", "label_source", "label_confidence", "split"],
  "properties": {
    "sample_id": {"type": "string"},
    "vulnerable": {"type": "string"},
    "fixed": {"type": "string"},
    "bug_types": {"type": "array", "items": {"type": "string"}},
    "expert_labels": {"type": "array", "items": {"enum": ["reentrancy", "arithmetic", "unchecked_calls", "optimized_operations", "access_control", "transaction_dependence", "block_dependence"]}, "uniqueItems": true},
    "label_source": {"type": "string"},
    "label_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "split": {"enum": ["train", "validation"]}
  },
  "additionalProperties": false
}
