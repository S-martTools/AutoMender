{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BehaviorValidationCases",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "oracle", "property"],
        "properties": {
          "id": {"type": "string"},
          "oracle": {"enum": ["repair-invariant", "repair-sensitive"]},
          "property": {"type": "string"},
          "inputs": {"type": "object"},
          "expected": {}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
