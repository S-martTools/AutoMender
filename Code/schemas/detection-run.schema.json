{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DetectionRun",
  "type": "object",
  "required": ["tool", "status", "findings", "runtime_seconds", "paper_eligible"],
  "properties": {
    "tool": {"type": "string"},
    "status": {"enum": ["success", "unavailable", "timeout", "error", "unsupported"]},
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "runtime_seconds": {"type": "number", "minimum": 0},
    "raw_artifact": {"type": "string"},
    "error": {"type": "string"},
    "paper_eligible": {"type": "boolean"}
  },
  "additionalProperties": false
}
