{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automender.local/schema/finding.json",
  "title": "Finding",
  "type": "object",
  "required": ["tool", "bug_type", "path", "line_start", "line_end", "confidence"],
  "properties": {
    "tool": {"type": "string"},
    "bug_type": {"enum": ["RE", "SU", "AS", "TOD", "REN", "IO", "UCL", "UCS", "TO", "REE", "TS", "BP", "ST", "CNE", "RR", "UUS", "EGL", "RDS", "BE", "AIB", "CS", "RTS", "EF", "COL"]},
    "path": {"type": "string"},
    "line_start": {"type": "integer", "minimum": 0},
    "line_end": {"type": "integer", "minimum": 0},
    "code": {"type": "string"},
    "function": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "string"}
  },
  "additionalProperties": false
}
